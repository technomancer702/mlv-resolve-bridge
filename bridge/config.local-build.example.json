{
  "output_root": ".build/exports",
  "asset_extensions": [".dng", ".wav"],
  "export_command": [
    "powershell",
    "-NoProfile",
    "-ExecutionPolicy",
    "Bypass",
    "-File",
    "{repo_root}/scripts/run-mlvapp-headless.ps1",
    "-Input",
    "{input}",
    "-OutputDir",
    "{output_dir}",
    "-Codec",
    "cdng-fast",
    "-CdngNaming",
    "resolve",
    "-Audio",
    "on"
  ]
}
